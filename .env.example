# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4 compatible)
# Password special characters must be percent-encoded (@ -> %40, # -> %23, / -> %2F ...)
DATABASE_URL=postgresql://postgres.YOURREF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Gap rules
MIN_PROFIT_PCT=0.10            # combined round-trip taker fees in PERCENT
MIN_LIQUIDITY_USD=300          # top-of-book notional required on BOTH books
PAPER_NOTIONAL_CAP_USD=1000    # max simulated trade size

# Goldilocks radar
VOL_MIN_USD=1000000
VOL_MAX_USD=80000000
TOP_N=20
RADAR_INTERVAL_S=30
FUNDING_APR_THRESHOLD_PCT=50

# Storage / ops
RAW_RETENTION_DAYS=60
LOG_LEVEL=INFO
